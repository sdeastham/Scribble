<Window x:Class="Scribble.Views.AudienceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Scribble.Controls"
        Title="Scribble — Audience View"
        Background="Black"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual">
    <Grid Background="Black">
        <controls:SlideViewport x:Name="Viewport" IsInteractive="False" />
    </Grid>
</Window>
