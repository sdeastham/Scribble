<Window x:Class="Scribble.Views.PresenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Scribble.Controls"
        Title="Scribble — Presenter"
        Width="1280"
        Height="800"
        WindowState="Maximized"
        Background="{StaticResource AppBackgroundBrush}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="RailButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.32" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuitButtonStyle" TargetType="Button" BasedOn="{StaticResource RailButtonStyle}">
            <Setter Property="Background" Value="#FF2E1E22" />
            <Setter Property="BorderBrush" Value="#FF6B2D38" />
            <Setter Property="Foreground" Value="#FFFF8A98" />
        </Style>

        <Style x:Key="SmallResetButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="6,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E622252B" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FF2F3542" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="72" />
        </Grid.ColumnDefinitions>

        <!-- Main Zoomable / Inkable Slide Canvas (Left & Center) -->
        <Grid Grid.Column="0">
            <controls:SlideViewport x:Name="Viewport" IsInteractive="True" />

            <!-- Reset Zoom Pill (Top-Right of canvas, visible ONLY when zoomed in) -->
            <Button x:Name="ResetZoomPill"
                    Style="{StaticResource PillButtonStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,16,16,0"
                    Visibility="Collapsed"
                    Click="ResetZoomPill_Click"
                    Content="Reset Zoom (100%)" />

            <!-- Welcome / Open PDF Overlay (Visible only before a PDF is opened) -->
            <Border x:Name="WelcomeOverlay"
                    Background="#FF181A1E"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                    <TextBlock Text="Scribble"
                               FontSize="38"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Decoupled dual-screen lecture inking for PDF slides"
                               FontSize="15"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,28" />

                    <Button x:Name="OpenPdfButton"
                            Content="Open Presentation PDF..."
                            Padding="28,14"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Background="{StaticResource AccentBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            HorizontalAlignment="Center"
                            Click="OpenPdfButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BtnBorder"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="12"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Opacity" Value="0.9" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock Text="or drag and drop a .pdf file anywhere onto this window"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,14,0,26" />

                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16,12">
                        <StackPanel>
                            <TextBlock x:Name="DisplayStatusText"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Stylus: ink &amp; tail/barrel eraser  ·  2 fingers / Wheel: zoom  ·  Right-drag: pan"
                                       FontSize="11.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Minimal Left-Handed Right-Edge Control Rail: Quit, Pen Colors, Prev/Next -->
        <Border Grid.Column="1"
                Background="#FF14161A"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,0,0,0">
            <DockPanel LastChildFill="False" Margin="0,12,0,16">

                <!-- 1. Quit (isolated at top-right) -->
                <Button x:Name="QuitButton"
                        DockPanel.Dock="Top"
                        Style="{StaticResource QuitButtonStyle}"
                        ToolTip="Quit (Esc)"
                        Click="QuitButton_Click">
                    <Path Data="M 4,4 L 14,14 M 14,4 L 4,14"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="2.2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Width="18"
                          Height="18" />
                </Button>

                <!-- Swap Presenter / Audience Screens (shown only when 2+ displays are connected) -->
                <Button x:Name="SwapScreensButton"
                        DockPanel.Dock="Top"
                        Style="{StaticResource RailButtonStyle}"
                        Height="38"
                        Margin="0,6,0,0"
                        Visibility="Collapsed"
                        ToolTip="Swap Presenter &amp; Audience Screens (Ctrl+Shift+S)"
                        Click="SwapScreensButton_Click">
                    <Path Data="M 3,7 L 15,7 M 12,4 L 15,7 L 12,10 M 17,13 L 5,13 M 8,10 L 5,13 L 8,16"
                          Stroke="{StaticResource TextPrimaryBrush}"
                          StrokeThickness="1.8"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Width="20"
                          Height="20" />
                </Button>

                <Rectangle DockPanel.Dock="Top"
                           Height="1"
                           Margin="14,10,14,10"
                           Fill="{StaticResource BorderBrush}" />

                <!-- 2. Pen Color Swatches (Black, Blue, Red, Green) & Stroke Eraser -->
                <StackPanel x:Name="PenSwatchesPanel"
                            DockPanel.Dock="Top"
                            HorizontalAlignment="Center" />

                <Button x:Name="EraserButton"
                        DockPanel.Dock="Top"
                        HorizontalAlignment="Center"
                        Margin="0,6,0,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Cursor="Hand"
                        Focusable="False"
                        ToolTip="Stroke Eraser (E)"
                        Click="EraserButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter />
                        </ControlTemplate>
                    </Button.Template>
                    <Border x:Name="EraserRing"
                            Width="44"
                            Height="44"
                            CornerRadius="22"
                            BorderThickness="2.5"
                            BorderBrush="Transparent"
                            Background="#FF202329">
                        <!-- Clean diagonal eraser icon -->
                        <Path Data="M 4,14 L 11,7 C 12,6 13.5,6 14.5,7 L 18,10.5 C 19,11.5 19,13 18,14 L 13,19 L 7,19 L 4,16 C 3,15 3,15 4,14 Z M 9,9 L 15,15 M 5,19 L 19,19"
                              Stroke="{StaticResource TextPrimaryBrush}"
                              StrokeThickness="1.7"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Width="22"
                              Height="22"
                              Stretch="Uniform" />
                    </Border>
                </Button>

                <Rectangle DockPanel.Dock="Top"
                           Height="1"
                           Margin="14,12,14,10"
                           Fill="{StaticResource BorderBrush}" />

                <!-- 3. Stroke Size Slider + Reset to 1x -->
                <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center">
                    <Grid Width="24" Height="22" HorizontalAlignment="Center" Margin="0,0,0,4">
                        <Ellipse x:Name="StrokeSizePreviewDot"
                                 Width="8"
                                 Height="8"
                                 Fill="{StaticResource TextPrimaryBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                    </Grid>

                    <Slider x:Name="StrokeSizeSlider"
                            Orientation="Vertical"
                            Height="84"
                            Minimum="0.4"
                            Maximum="3.0"
                            Value="1.0"
                            SmallChange="0.1"
                            LargeChange="0.25"
                            IsMoveToPointEnabled="True"
                            Focusable="False"
                            HorizontalAlignment="Center"
                            ToolTip="Stroke Size"
                            ValueChanged="StrokeSizeSlider_ValueChanged" />

                    <Button x:Name="ResetStrokeSizeButton"
                            Style="{StaticResource SmallResetButtonStyle}"
                            Margin="0,6,0,0"
                            HorizontalAlignment="Center"
                            Content="1.0×"
                            ToolTip="Reset stroke size to 1×"
                            Click="ResetStrokeSizeButton_Click" />
                </StackPanel>

                <!-- 4 & 5. Previous / Next Slide (bottom-right) -->
                <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center">
                    <Button x:Name="PrevSlideButton"
                            Style="{StaticResource RailButtonStyle}"
                            ToolTip="Previous Slide (Left / PageUp)"
                            IsEnabled="False"
                            Click="PrevSlideButton_Click">
                        <Path Data="M 13,3 L 6,10 L 13,17"
                              Stroke="{StaticResource TextPrimaryBrush}"
                              StrokeThickness="2.3"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Width="20"
                              Height="20" />
                    </Button>

                    <TextBlock x:Name="SlideCounterText"
                               Text="— / —"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,6" />

                    <Button x:Name="NextSlideButton"
                            Style="{StaticResource RailButtonStyle}"
                            ToolTip="Next Slide (Right / PageDown)"
                            IsEnabled="False"
                            Click="NextSlideButton_Click">
                        <Path Data="M 7,3 L 14,10 L 7,17"
                              Stroke="{StaticResource TextPrimaryBrush}"
                              StrokeThickness="2.3"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Width="20"
                              Height="20" />
                    </Button>
                </StackPanel>

            </DockPanel>
        </Border>
    </Grid>
</Window>
